import /init.recovery.tee.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 0

    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw

# We need vold early for metadata encryption
on early-fs
    start vold

on fs
    mount_all /first_stage_ramdisk/fstab.mt8765 --late
    wait /dev/block/platform/soc/11230000.mmc
    symlink /dev/block/platform/soc/11230000.mmc /dev/block/bootdevice
    symlink /dev/block/by-name/para /dev/block/by-name/misc
    mkdir /mnt/vendor 0755 system system
    mkdir /mnt/vendor/protect_f 0770 system system
    mkdir /mnt/vendor/protect_s 0770 system system
    mkdir /mnt/vendor/nvdata 0771 system system
    mkdir /mnt/vendor/nvcfg 0771 system system
    mkdir /mnt/vendor/persist 0771 system system
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f rw wait
    mount ext4 /dev/block/by-name/protect2 /mnt/vendor/protect_s rw wait
    mount ext4 /dev/block/by-name/nvdata /mnt/vendor/nvdata rw wait
    mount ext4 /dev/block/by-name/nvcfg /mnt/vendor/nvcfg rw wait
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist rw wait

on post-fs-data
    mkdir /data/vendor_de 0770 system system
    mkdir /data/vendor_de/0 0770 system system

    start health-hal-2-1
    setprop sys.usb.config adb

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user system
    group system
    seclabel u:r:recovery:s0

service vendor.keymaster-4-0-trustkernel /vendor/bin/hw/android.hardware.keymaster@4.0-service.trustkernel
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    class early_hal
    user system
    group system drmrpc
    seclabel u:r:recovery:s0

service keystore /system/bin/keystore /tmp/misc/keystore
    class main
    user root
    group root drmrpc readproc log
    seclabel u:r:recovery:s0
    disabled

service keystore_auth /system/bin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0

on init
    setprop crypto.ready 1

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    write /proc/bootprof "crypto: install_keyring"
    install_keyring

on property:hwservicemanager.ready=true
    start vendor.gatekeeper-1-0
    start vendor.keymaster-4-0-trustkernel

on property:ro.crypto.state=unsupported
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymaster-4-0-trustkernel

on property:ro.crypto.state=unencrypted
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymaster-4-0-trustkernel

on property:twrp.all.users.decrypted=true
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymaster-4-0-trustkernel

on property:crypto.ready=0
    stop teed
    stop vendor.gatekeeper-1-0
    stop vendor.keymaster-4-0-trustkernel

on fs && property:ro.debuggable=0
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on property:sys.usb.config=fastboot
    start servicemanager
    start hwservicemanager
    restart fastbootd
